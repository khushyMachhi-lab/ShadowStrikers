# =============================================================
# ShadowStrikers - Environment Configuration
# Copy this file to .env and fill in your values before deploying.
#
# NEVER commit the .env file to version control!
# =============================================================

# ---- MySQL ----
MYSQL_DATABASE=shadowstrikers
MYSQL_USER=shadowstriker
MYSQL_PASSWORD=change-this-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-this-to-a-strong-root-password

# ---- Admin Login ----
ADMIN_EMAIL=admin@shadowstrikers.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Email (SMTP) ----
# Uncomment and fill in for email functionality (registration, OTP, etc.)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# ---- Google Calendar API ----
# Uncomment and fill in for batch time Google Meet integration
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token